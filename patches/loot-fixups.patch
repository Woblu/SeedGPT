     lf->varparams_int_arr_size = 0;
 }
 
+// A function whose only effect is the random draw: set_instrument picks a
+// goat horn's sound with one nextInt over its tag, and leaving that draw out
+// shifts every roll after it.
+static void skip_next_int_function(uint64_t* rand, ItemStack* is, const void* params)
+{
+    (void)is;
+    nextInt(rand, ((const int*)params)[0]);
+}
+
+void create_skip_next_int(LootFunction* lf, const int bound)
+{
+    init_function(lf);
+    lf->params = lf->params_int;
+    lf->params_int[0] = bound;
+    lf->fun = skip_next_int_function;
+}
+
 void create_set_count(LootFunction* lf, const int min, const int max)
 {
     init_function(lf);
