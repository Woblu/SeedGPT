# Build output
build/
*.class
__pycache__/

# The engine is a pinned upstream clone, not our source. setup.sh restores it
# at the exact commit this project was verified against.
cubiomes/

# Generated by ask.py / test runs
queries/_*.json

# cubiomes-viewer (GPL-3.0) source must never enter this repo -- this project
# links MIT cubiomes only and stays MIT-compatible. Copies of these once sat in
# the project root after a research detour; they were deleted, and this keeps
# them from coming back by accident.
/search.h
/search.cpp
/searchthread.cpp

# scratch renders
build/tmp/

# Real-worldgen tier-2 backend (Fabric Loom / Minecraft dev env)
tools/gradle-dist/
tier2/.gradle/
tier2/build/
tier2/out/
tier2/cp.txt
build/fu/
tier2/logs/
logs/
# Harvested oracle data: reproducible by re-running the collectors, and large.
tier3-bedrock/*.jsonl
tier3-bedrock/obs_*.txt
# Bedrock Dedicated Server: Mojang's binaries and the throwaway worlds the
# oracle generates. The harness that drives it IS tracked; the server is not.
tier3-bedrock/server/
tier3-bedrock/server[0-9]*/
tier3-bedrock/bds.zip
tier3-bedrock/out/
tier2-outpost/.gradle/
tier2-outpost/build/
tier2-outpost/out/
tier2-outpost/cp.txt
tier2-outpost/logs/

# Decompiled Minecraft sources (gradle genSources). Mojang's mappings allow
# deobfuscation locally; the CODE stays proprietary, so it is read here and
# never committed or redistributed.
tier2-outpost/*-sources.jar
tier2-outpost/sources/
